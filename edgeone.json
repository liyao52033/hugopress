{
    "headers": [
        {
            "source": "/*",
            "headers": [
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Cache-Control",
                    "value": "max-age=2592000"
                }
            ]
        },
        {
            "source": "/",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "text/html; charset=utf-8"
                }
            ]
        },
        {
            "source": "/pages/*",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "text/html; charset=utf-8"
                }
            ]
        },
        {
            "source": "/images/*",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "max-age=31536000"
                }
            ]
        },
        {
            "source": "/img/*",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "max-age=31536000"
                }
            ]
        },
        {
            "source": "/ws/location/*",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "max-age=0, private, must-revalidate"
                }
            ]
        },
        {
            "source": "/ws/weather/*",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "max-age=0, private, must-revalidate"
                }
            ]
        }
    ]
}