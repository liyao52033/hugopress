{
    "buildCommand": "yarn run build:prod",
    "installCommand": "yarn install",
    "outputDirectory": "./dist",
    "headers": [
        {
            "source": "/*",
            "headers": [
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Cache-Control",
                    "value": "max-age=7200"
                }
            ]
        },
        {
            "source": "/images/*",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "max-age=31536000"
                }
            ]
        },
        {
            "source": "/img/*",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "max-age=31536000"
                }
            ]
        }
    ]
}